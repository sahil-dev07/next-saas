# ==============================================================================
# imaginify (next-saas) — environment template
# Copy to `.env.local` and fill real values. NEVER commit `.env.local`.
# App Router reads NEXT_PUBLIC_* into the client bundle; all others are server-only.
# Placeholders below are intentionally NOT valid key formats (secret scanners).
# ==============================================================================

# --- MongoDB -----------------------------------------------------------------
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/imaginify   # Full connection string

# --- Clerk (auth) ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key    # Clerk Dashboard > API Keys (public, client-safe)
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key                         # Clerk Dashboard > API Keys (SECRET, server-only)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in                                 # Route to Clerk <SignIn/> page
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up                                 # Route to Clerk <SignUp/> page
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/                                  # v4 name. Clerk v5+ renamed this -> NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/                                  # v4 name. Clerk v5+ renamed this -> NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL

# --- Clerk webhook -----------------------------------------------------------
# TRAP: Clerk's signing secret is named WEBHOOK_SECRET (no "CLERK_" prefix) — see app/api/webhooks/clerk/route.ts.
# Do NOT confuse with STRIPE_WEBHOOK_SECRET below.
WEBHOOK_SECRET=whsec_your-clerk-webhook-signing-secret                 # Clerk Dashboard > Webhooks > (endpoint) > Signing Secret

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key                       # Stripe Dashboard > Developers > API keys (SECRET, server-only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key # Stripe publishable key (client-safe)

# --- Stripe webhook ----------------------------------------------------------
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret         # Stripe Dashboard > Developers > Webhooks > Signing secret

# --- Cloudinary --------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name                      # Cloudinary cloud name (client-safe; used by next-cloudinary)
CLOUDINARY_API_KEY=your-cloudinary-api-key                            # Cloudinary API key (server-only)
CLOUDINARY_API_SECRET=your-cloudinary-api-secret                      # Cloudinary API secret (server-only)

# --- App URL -----------------------------------------------------------------
NEXT_PUBLIC_SERVER_URL=http://localhost:3000                          # Base URL for Stripe checkout success/cancel; set to prod domain on Vercel
